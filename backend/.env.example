# Copy to .env for local work against a real Postgres. On Render these are set in the dashboard (see render.yaml).
# `npm run dev:local` needs none of this: it uses an in-process database.

NODE_ENV=development
PORT=4000

# Render gives you this on the database page. Use the "Internal" URL for the web service.
DATABASE_URL=postgres://user:password@localhost:5432/p5hours
# Set to 1 if you connect to the database from outside Render (the "External" URL needs TLS).
DATABASE_SSL=

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The frontend address(es), comma separated, no trailing slash.
CORS_ORIGIN=http://localhost:3000
# Used to build the "set your password" links in emails.
APP_URL=http://localhost:3000

# Creates the first admin the first time the server starts on an empty database. Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Email (https://resend.com). Without a key, emails are logged instead of sent and the admin copies links by hand.
RESEND_API_KEY=
MAIL_FROM=P5 Client Hours <onboarding@resend.dev>
